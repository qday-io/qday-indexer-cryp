# JSON-RPC of a full or archive node. host.docker.internal reaches the host.
RPC_URL=http://host.docker.internal:8545

# Inclusive block range.
FROM_BLOCK=18000000
TO_BLOCK=18001000

# Blocks fetched per batch.
BATCH=1000

# Optional.
CONCURRENCY=8
RPC_BATCH=20
RESUME=false
EXCLUDE_SEEDS_FROM_HOP2=false
