# JSON-RPC of a full or archive node. host.docker.internal reaches the host.
RPC_URL=http://host.docker.internal:8545

# First block. Defaults to 1, the start of the chain.
FROM_BLOCK=1

# Last block. Leave empty to keep following the chain head.
TO_BLOCK=

# Stay this many blocks behind the latest block. 0 indexes the head.
CONFIRM=0

# Blocks fetched per batch.
BATCH=1000

# Optional.
CONCURRENCY=8
RPC_BATCH=20
RESUME=false
